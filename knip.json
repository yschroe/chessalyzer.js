{
    "$schema": "./node_modules/knip/schema.json",
    "workspaces": {
        ".": {
            "entry": [
                "src/index.ts",
                "src/core/chess-worker.ts",
                "src/export/io.ts",
                "src/export/pgn.ts",
                "src/export/replay.ts",
                "src/export/trackers.ts",
                "bench/*.ts",
                "bench/{atomic,exploratory}/*.ts"
            ],
            "ignore": ["manual-tests/**"]
        },
        "docs": {
            "entry": ["src/pages/**/*.{ts,tsx}", "waku.config.ts"]
        }
    }
}
