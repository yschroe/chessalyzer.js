{
    "$schema": "./node_modules/knip/schema.json",
    "workspaces": {
        ".": {
            "entry": [
                "src/index.ts",
                "src/chess-worker.ts",
                "src/pgn/index.ts",
                "src/board/index.ts",
                "src/replay/index.ts",
                "src/trackers/index.ts",
                "bench/*.ts",
                "bench/{atomic,exploratory}/*.ts"
            ],
            "ignore": ["manual-tests/**", "test/types/**", "test/integration/**/*.type-test.ts"]
        },
        "docs": {
            "entry": ["src/pages/**/*.{ts,tsx}", "waku.config.ts"]
        }
    }
}
