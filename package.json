{
    "name": "chessalyzer",
    "version": "4.0.0-beta.1",
    "description": "A JavaScript library for batch analyzing chess games.",
    "keywords": [
        "analysis",
        "batch",
        "chess",
        "heatmap",
        "pgn"
    ],
    "homepage": "https://github.com/yschroe/chessalyzer",
    "bugs": {
        "url": "https://github.com/yschroe/chessalyzer/issues"
    },
    "license": "MIT",
    "author": "Yannik Schröder",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/yschroe/chessalyzer.git"
    },
    "workspaces": [
        "docs"
    ],
    "files": [
        "lib/**/*"
    ],
    "type": "module",
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "imports": {
        "#core/*": "./src/core/*.ts",
        "#replay/*": "./src/replay/*.ts",
        "#board/*": "./src/board/*.ts",
        "#trackers/*": "./src/trackers/*.ts",
        "#io/*": "./src/io/*.ts",
        "#pgn/*": "./src/pgn/*.ts",
        "#types/*": "./src/types/*.ts"
    },
    "exports": {
        ".": {
            "types": "./lib/index.d.ts",
            "import": "./lib/index.js"
        },
        "./pgn": {
            "types": "./lib/pgn/index.d.ts",
            "import": "./lib/pgn/index.js"
        },
        "./board": {
            "types": "./lib/board/index.d.ts",
            "import": "./lib/board/index.js"
        },
        "./replay": {
            "types": "./lib/replay/index.d.ts",
            "import": "./lib/replay/index.js"
        },
        "./trackers": {
            "types": "./lib/trackers/index.d.ts",
            "import": "./lib/trackers/index.js"
        }
    },
    "scripts": {
        "build": "bun scripts/create-bundle.ts",
        "test": "bun test",
        "test:unit": "bun test src",
        "test:integration": "bun test test/integration",
        "test:build-fixtures": "bun run build && bun scripts/build-fixture-manifest.ts",
        "lint": "oxlint",
        "format": "oxfmt",
        "typecheck": "tsc --noEmit",
        "knip": "knip-bun",
        "bench:perf": "tsx bench/bench-perf.ts",
        "bench:perf:bun": "bun bench/bench-perf.ts",
        "bench:atomic": "tsx bench/bench-atomic.ts",
        "bench:atomic:bun": "bun bench/bench-atomic.ts",
        "bump": "bumpp",
        "release:notes": "node scripts/release-notes.mjs",
        "release:pack": "node scripts/npm-publish.mjs --dry-run",
        "docs:dev": "bun run --filter chessalyzer-docs dev",
        "docs:build": "bun run --filter chessalyzer-docs build",
        "docs:preview": "bun run --filter chessalyzer-docs preview",
        "docs:typecheck": "bun run --filter chessalyzer-docs typecheck"
    },
    "devDependencies": {
        "@types/bun": "^1.3.14",
        "@types/node": "^26.2.0",
        "bumpp": "^12.2.0",
        "bun-plugin-dts": "^0.4.0",
        "knip": "^6.32.0",
        "oxfmt": "^0.62.0",
        "oxlint": "^1.77.0",
        "oxlint-tsgolint": "^7.0.2001",
        "tinybench": "^6.1.2",
        "tsx": "^4.23.11",
        "typescript": "6.0.3"
    },
    "overrides": {
        "@types/node": "^26.2.0"
    },
    "engines": {
        "node": ">=22"
    }
}
