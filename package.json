{
    "name": "chessalyzer.js",
    "version": "3.0.6",
    "description": "A JavaScript library for batch analyzing chess games.",
    "keywords": [
        "analysis",
        "batch",
        "chess",
        "heatmap",
        "pgn"
    ],
    "homepage": "https://github.com/yschroe/chessalyzer.js",
    "bugs": {
        "url": "https://github.com/yschroe/chessalyzer.js/issues"
    },
    "license": "MIT",
    "author": "Yannik Schröder",
    "repository": {
        "type": "git",
        "url": "https://github.com/yschroe/chessalyzer.js"
    },
    "files": [
        "lib/**/*"
    ],
    "type": "module",
    "main": "lib/chessalyzer.js",
    "types": "lib/chessalyzer.d.ts",
    "exports": {
        ".": {
            "types": "./lib/index.d.ts",
            "import": "./lib/index.js"
        }
    },
    "imports": {
        "#core/*": "./src/core/*.ts",
        "#parsing/*": "./src/parsing/*.ts",
        "#board/*": "./src/board/*.ts",
        "#tracker/*": "./src/tracker/*.ts",
        "#pgn/*": "./src/pgn/*.ts",
        "#types/*": "./src/types/*.ts"
    },
    "scripts": {
        "build": "bun ./scripts/create-bundle.ts",
        "test": "bun test",
        "test:corpus": "bun test test/integration/corpus.test.js",
        "test:fetch-corpus": "bun ./scripts/fetch-test-corpus.ts",
        "test:build-fixtures": "bun run build && bun ./scripts/build-fixture-manifest.ts",
        "lint": "oxlint",
        "format": "oxfmt",
        "typecheck": "tsc --noEmit",
        "knip": "knip"
    },
    "dependencies": {
        "chalk": "^5.6.2"
    },
    "devDependencies": {
        "@types/bun": "^1.3.14",
        "@types/node": "^26.1.1",
        "bun-plugin-dts": "^0.4.0",
        "knip": "^6.29.0",
        "oxfmt": "^0.60.0",
        "oxlint": "^1.75.0",
        "oxlint-tsgolint": "^7.0.2001",
        "typescript": "^7.0.2"
    },
    "overrides": {
        "@types/node": "^26.1.1"
    },
    "engines": {
        "node": ">=22"
    }
}
